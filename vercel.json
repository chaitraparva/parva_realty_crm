{
  "version": 2,
  "builds": [
    {
      "src": "parva_crm/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/parva_backend_supabase/backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/parva_backend_supabase/backend/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "parva_crm/dist/$1"
    }
  ]
}