# ============================================================================
# BACKEND / SERVER VARIABLES — set these on your Node hosting platform
# (Render, Railway, Fly.io, an EC2/VM, etc.), NOT in the frontend build.
# ============================================================================

# Supabase project settings → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ⚠ SECRET. Server-only. Bypasses Row Level Security. NEVER prefix this with
# VITE_, never send it to the browser, never commit a real value to git.
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key — safe to use server-side for password sign-in only.
SUPABASE_ANON_KEY=

# The deployed frontend origin(s) allowed by CORS. A single origin, or a
# comma-separated list (e.g. your production domain + a Vercel preview URL).
# Local dev already allows http://localhost:5173 automatically.
FRONTEND_URL=https://your-parva-crm.vercel.app

NODE_ENV=production
PORT=5000
# ^ PORT is only used when running this as a long-lived server (Render,
# Railway, a VM, `npm start`). It is ignored on Vercel — Vercel calls
# api/index.js directly as a serverless function and never runs src/index.js.

# LiveKit WebRTC video/voice calling configuration (Server-only secrets)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ============================================================================
# FRONTEND / VERCEL VARIABLES — set these in the parva_crm Vite project,
# NOT here. Listed for reference only:
#
#   VITE_API_URL=https://your-backend-host.example.com
#
# Do NOT add VITE_SUPABASE_SERVICE_ROLE_KEY or any service-role key to the
# frontend under any name — anything prefixed VITE_ is bundled into the
# public JS and visible to every visitor.
# ============================================================================
